{
  "$schema": "https://schemas.designtokens.org/dtcg/draft-spec",
  "$description": "Zepo Design Tokens · W3C DTCG format. Source of truth para colores, tipografía, spacing y motion. Lee DESIGN.md primero.",

  "color": {
    "primitive": {
      "bg":       { "$value": "#0A0A0F", "$type": "color", "$description": "Fondo principal (near-black)" },
      "surface":  { "$value": "#13131A", "$type": "color", "$description": "Cards y contenedores de primer nivel" },
      "surface2": { "$value": "#191923", "$type": "color", "$description": "Cards anidadas, inputs activos" },
      "border":   { "$value": "#1E1E2E", "$type": "color", "$description": "Bordes default 1px" },
      "border2":  { "$value": "#2A2A3D", "$type": "color", "$description": "Bordes hover, dividers fuertes" },

      "cyan":    { "$value": "#00F0FF", "$type": "color", "$description": "Acento primario · CTAs principales, links" },
      "purple":  { "$value": "#7000FF", "$type": "color", "$description": "Acento secundario · gradiente, plan elite" },
      "text":    { "$value": "#FFFFFF", "$type": "color" },
      "muted":   { "$value": "#8888AA", "$type": "color", "$description": "Texto secundario, captions" },
      "dim":     { "$value": "#5A5A75", "$type": "color", "$description": "Texto deshabilitado, placeholders" },

      "success": { "$value": "#00E5A0", "$type": "color", "$description": "Ingresos, confirmaciones" },
      "warning": { "$value": "#FFB800", "$type": "color", "$description": "Alertas presupuesto >75%" },
      "danger":  { "$value": "#FF6B6B", "$type": "color", "$description": "Errores, eliminar, presupuesto >100%" }
    },

    "semantic": {
      "feedback-success":     { "$value": "{color.primitive.success}", "$type": "color" },
      "feedback-warning":     { "$value": "{color.primitive.warning}", "$type": "color" },
      "feedback-danger":      { "$value": "{color.primitive.danger}", "$type": "color" },
      "interactive-primary":  { "$value": "{color.primitive.cyan}", "$type": "color" },
      "interactive-elite":    { "$value": "{color.primitive.purple}", "$type": "color" },
      "text-primary":         { "$value": "{color.primitive.text}", "$type": "color" },
      "text-secondary":       { "$value": "{color.primitive.muted}", "$type": "color" },
      "text-disabled":        { "$value": "{color.primitive.dim}", "$type": "color" }
    }
  },

  "gradient": {
    "signature": {
      "$value": "linear-gradient(135deg, #00F0FF 0%, #7000FF 100%)",
      "$type": "gradient",
      "$description": "Gradient principal — diagonal 135° cian → púrpura. Usar en: heroes, CTAs primarios, montos hero, plan-card.elite"
    },
    "horizontal": {
      "$value": "linear-gradient(90deg, #00F0FF 0%, #7000FF 100%)",
      "$type": "gradient",
      "$description": "Variante horizontal — usar en bordes finos, dividers, progress bars"
    },
    "subtle-bg": {
      "$value": "linear-gradient(135deg, rgba(0,240,255,0.10), rgba(112,0,255,0.10))",
      "$type": "gradient",
      "$description": "Fondo con tinte gradient para banners de promo y upsells"
    }
  },

  "font": {
    "family": {
      "sans": { "$value": "'Inter', -apple-system, system-ui, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', 'SF Mono', ui-monospace, monospace", "$type": "fontFamily", "$description": "Solo para montos numéricos. Activar tabular nums." }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" },
      "extrabold":{ "$value": 800, "$type": "fontWeight", "$description": "Heroes y montos grandes" }
    },
    "size": {
      "xs":   { "$value": "11px", "$type": "dimension", "$description": "Captions, labels uppercase" },
      "sm":   { "$value": "13px", "$type": "dimension", "$description": "Body secundario, subtítulos" },
      "base": { "$value": "15px", "$type": "dimension", "$description": "Body principal, botones" },
      "md":   { "$value": "18px", "$type": "dimension", "$description": "Títulos de sección" },
      "lg":   { "$value": "24px", "$type": "dimension", "$description": "Headers de pantalla" },
      "xl":   { "$value": "32px", "$type": "dimension" },
      "hero": { "$value": "48px", "$type": "dimension", "$description": "Monto hero (balance principal)" },
      "hero-lg": { "$value": "56px", "$type": "dimension", "$description": "Splash, brand sheet" }
    },
    "tracking": {
      "tight":  { "$value": "-1.5px", "$type": "dimension", "$description": "Heroes y números grandes" },
      "tighter":{ "$value": "-0.8px", "$type": "dimension", "$description": "Headers de pantalla" },
      "default":{ "$value": "0", "$type": "dimension" },
      "wide":   { "$value": "1.2px", "$type": "dimension", "$description": "Labels uppercase" }
    }
  },

  "radius": {
    "sm":   { "$value": "8px",  "$type": "dimension", "$description": "Chips, badges" },
    "md":   { "$value": "12px", "$type": "dimension" },
    "lg":   { "$value": "14px", "$type": "dimension", "$description": "Botones default" },
    "xl":   { "$value": "16px", "$type": "dimension", "$description": "Cards" },
    "2xl":  { "$value": "20px", "$type": "dimension", "$description": "Cards hero, sheets" },
    "3xl":  { "$value": "24px", "$type": "dimension" },
    "pill": { "$value": "999px","$type": "dimension", "$description": "Botones pill, FAB" }
  },

  "spacing": {
    "0":  { "$value": "0",    "$type": "dimension" },
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension", "$description": "Spacing base. Múltiplos de 4 obligatorios." },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension", "$description": "Padding horizontal de pantalla" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },

  "shadow": {
    "card":      { "$value": "0 8px 32px rgba(0,0,0,0.4)", "$type": "shadow" },
    "card-inset":{ "$value": "inset 0 1px 0 rgba(255,255,255,0.06)", "$type": "shadow", "$description": "Highlight superior en cards glass" },
    "fab":       { "$value": "0 4px 16px rgba(0,240,255,0.3)", "$type": "shadow" },
    "glow-cyan": { "$value": "0 0 32px rgba(0,240,255,0.15)", "$type": "shadow" },
    "glow-purple":{ "$value": "0 0 32px rgba(112,0,255,0.15)", "$type": "shadow" },
    "focus":     { "$value": "0 0 0 3px rgba(0,240,255,0.2)", "$type": "shadow", "$description": "Outline focus accesible" }
  },

  "blur": {
    "sheet":    { "$value": "blur(24px) saturate(140%)", "$type": "string", "$description": "Glass effect para sheets y modals" },
    "subtle":   { "$value": "blur(12px) saturate(120%)", "$type": "string" }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "80ms",  "$type": "duration", "$description": "Tap feedback" },
      "fast":    { "$value": "120ms", "$type": "duration" },
      "base":    { "$value": "200ms", "$type": "duration" },
      "slow":    { "$value": "320ms", "$type": "duration", "$description": "Sheet entrance" },
      "slower":  { "$value": "480ms", "$type": "duration" }
    },
    "easing": {
      "default":  { "$value": "ease-out", "$type": "cubicBezier" },
      "ios":      { "$value": "cubic-bezier(0.32, 0.72, 0, 1)", "$type": "cubicBezier", "$description": "Sheets, hojas modales — sensación nativa iOS" },
      "spring":   { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "Bounces sutiles para confirmaciones" }
    }
  },

  "viewport": {
    "max-width": { "$value": "480px", "$type": "dimension", "$description": "App es mobile-first. Sobre 480px se centra." },
    "screen-w":  { "$value": "402px", "$type": "dimension", "$description": "Ancho típico de mockup CD" },
    "screen-h":  { "$value": "874px", "$type": "dimension" }
  }
}
